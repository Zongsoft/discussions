### 列表操作
@id = {{$input 站点编号 $value:100 }}
GET /Discussions/Sites/{{id}}/Users?page={{page}} HTTP/1.1
Host: {{host}}:{{port}}
Authorization: Credential {{credentialId}}

### 新增操作
@siteId = {{$input 站点编号 $value:100 }}
@userId = {{$input 用户编号 $value:100 }}
POST /Discussions/Sites/{{siteId}}/Users HTTP/1.1
Host: {{host}}:{{port}}
Authorization: Credential {{credentialId}}

[
	{
		"UserId": {{userId}}
	}
]

### 增改操作
@siteId = {{$input 站点编号 $value:100 }}
@userId = {{$input 用户编号 $value:100 }}
PUT /Discussions/Sites/{{siteId}}/Users HTTP/1.1
Host: {{host}}:{{port}}
Authorization: Credential {{credentialId}}

[
	{
		"UserId": {{userId}}
	}
]

### 更新操作
@siteId = {{$input 站点编号 $value:100 }}
@userId = {{$input 用户编号 $value:100 }}
PATCH /Discussions/Sites/{{siteId}}/Users HTTP/1.1
Host: {{host}}:{{port}}
Authorization: Credential {{credentialId}}

[
	{
		"UserId": {{userId}}
	}
]

### 删除操作
@siteId = {{$input 站点编号 $value:404 }}
@userId = {{$input 用户编号 $value:1 }}
DELETE /Discussions/Sites/Users/{{siteId}}-{{userId}} HTTP/1.1
Host: {{host}}:{{port}}
Authorization: Credential {{credentialId}}

### 批量删除
DELETE /Discussions/Sites/Users HTTP/1.1
Host: {{host}}:{{port}}
Authorization: Credential {{credentialId}}

404-1,404-2,404-3

### 清空操作
@id = {{$input 站点编号 $value:404 }}
DELETE /Discussions/Sites/{{id}}/Users HTTP/1.1
Host: {{host}}:{{port}}
Authorization: Credential {{credentialId}}
